        ($h2 (add_to_heap $h1 2 (qitem b)))
        ($h3 (add_to_heap $h2 -1.5 (qitem ())))
        ($h4 (add_to_heap $h3 -2 (qitem b)))
        ($h5 (add_to_heap $h4 2.0 x)))
   (np-result d0 (np-drained (np-drain $h5 ()))))
