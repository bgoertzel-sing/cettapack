diff --git a/src/cetta_evprof.c b/src/cetta_evprof.c
new file mode 100644
index 00000000..13307df1
--- /dev/null
+++ b/src/cetta_evprof.c
@@ -0,0 +1,176 @@
+/* cettapack cetta-internals P (0011): the evaluator phase timers' runtime:
+ * start-up, allocator wrappers (-Wl,--wrap), overhead calibration and the
+ * report.  Linked only with CETTA_EVPROF=1. */
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#include "cetta_evprof.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <sys/resource.h>
+
+#if CETTA_EVPROF
+static const char *const evp_names[CETTA_EVP__COUNT] = {
+#define EVP(fn, phase) #fn,
+#include "cetta_evprof_sites.def"
+#undef EVP
+    "malloc", "calloc", "realloc", "free", "(calibration parent)", "(calibration child)",
+};
+static const char *const evp_phases[CETTA_EVP__COUNT] = {
+#define EVP(fn, phase) phase,
+#include "cetta_evprof_sites.def"
+#undef EVP
+    "alloc", "alloc", "alloc", "alloc", "calibration", "calibration",
+};
+
+static uint64_t evp_t0, evp_ns0;
+static uint64_t evp_alloc_bytes;
+static uint64_t evp_free_null; /* free(NULL): no frame, counted only */
+
+static uint64_t evp_mono_ns(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+
+__attribute__((constructor)) static void evp_start(void) {
+    const char *out = getenv("CETTA_EVPROF_OUT");
+    if (!out || !out[0])
+        return;
+    evp_ns0 = evp_mono_ns();
+    evp_t0 = __rdtsc();
+    cetta_evprof_tls.on = 1;
+}
+
+/* Allocator wrappers: every malloc/calloc/realloc/free of CeTTa's own code
+ * (and of statically linked code such as the MORK bridge) is a frame. */
+void *__real_malloc(size_t n);
+void *__real_calloc(size_t n, size_t m);
+void *__real_realloc(void *p, size_t n);
+void __real_free(void *p);
+void *__wrap_malloc(size_t n) {
+    CETTA_EVPROF_SCOPE(CETTA_EVP_ALLOC_MALLOC);
+    evp_alloc_bytes += n;
+    return __real_malloc(n);
+}
+void *__wrap_calloc(size_t n, size_t m) {
+    CETTA_EVPROF_SCOPE(CETTA_EVP_ALLOC_CALLOC);
+    evp_alloc_bytes += n * m;
+    return __real_calloc(n, m);
+}
+void *__wrap_realloc(void *p, size_t n) {
+    CETTA_EVPROF_SCOPE(CETTA_EVP_ALLOC_REALLOC);
+    evp_alloc_bytes += n;
+    return __real_realloc(p, n);
+}
+void __wrap_free(void *p) {
+    if (!p) {
+        evp_free_null++;
+        return;
+    }
+    CETTA_EVPROF_SCOPE(CETTA_EVP_ALLOC_FREE);
+    __real_free(p);
+}
+
+/* Overhead calibration.  A frame costs time in two places: inside it (from
+ * its start stamp to its end stamp, part of enter and leave: c_in per
+ * frame) and in its parent (the rest of enter and leave: c_out per child
+ * frame).  Measured on empty frames: parent P with N empty children C.
+ * Then self(C) = N*c_in and self(P) = N*c_out + loop overhead.  Run R times,
+ * keep the minimum per quantity (a lower bound: real frames also miss in
+ * the caches, so subtraction under-corrects). */
+static __attribute__((noinline)) void evp_cal_child(void) {
+    CETTA_EVPROF_SCOPE(CETTA_EVP_CAL_CHILD);
+    __asm__ volatile("" ::: "memory");
+}
+static __attribute__((noinline)) void evp_cal_parent(uint32_t n) {
+    CETTA_EVPROF_SCOPE(CETTA_EVP_CAL_PARENT);
+    for (uint32_t i = 0; i < n; i++)
+        evp_cal_child();
+}
+static void evp_calibrate(double *c_in, double *c_out, double *c_in_med, double *c_out_med) {
+    enum { R = 21, N = 200000 };
+    double in[R], outv[R];
+    CettaEvprofSite *p = &cetta_evprof_sites[CETTA_EVP_CAL_PARENT];
+    CettaEvprofSite *c = &cetta_evprof_sites[CETTA_EVP_CAL_CHILD];
+    for (int r = 0; r < R; r++) {
+        uint64_t ps = p->self, cs = c->self;
+        evp_cal_parent(N);
+        in[r] = (double)(c->self - cs) / N;
+        outv[r] = (double)(p->self - ps) / N;
+    }
+    for (int i = 0; i < R; i++)
+        for (int j = i + 1; j < R; j++) {
+            if (in[j] < in[i]) { double t = in[i]; in[i] = in[j]; in[j] = t; }
+            if (outv[j] < outv[i]) { double t = outv[i]; outv[i] = outv[j]; outv[j] = t; }
+        }
+    *c_in = in[0];
+    *c_out = outv[0];
+    *c_in_med = in[R / 2];
+    *c_out_med = outv[R / 2];
+}
+
+static void evp_json_str(FILE *f, const char *s) {
+    fputc('"', f);
+    for (; *s; s++) {
+        if (*s == '"' || *s == '\\') fputc('\\', f);
+        fputc(*s, f);
+    }
+    fputc('"', f);
+}
+
+__attribute__((destructor)) static void evp_report(void) {
+    CettaEvprofState *s = &cetta_evprof_tls;
+    const char *out = getenv("CETTA_EVPROF_OUT");
+    if (!s->on || !out || !out[0])
+        return;
+    uint64_t t1 = __rdtsc();
+    uint64_t ns1 = evp_mono_ns();
+    uint32_t open_frames = s->depth;
+    while (s->depth) /* frames still open at exit (main's callers) */
+        cetta_evprof_pop(s, t1);
+    struct rusage ru;
+    getrusage(RUSAGE_SELF, &ru);
+    double c_in, c_out, c_in_med, c_out_med;
+    evp_calibrate(&c_in, &c_out, &c_in_med, &c_out_med);
+    s->on = 0;
+    FILE *f = fopen(out, "w");
+    if (!f)
+        return;
+    double hz = (double)(t1 - evp_t0) * 1e9 / (double)(ns1 - evp_ns0);
+    fprintf(f, "{\n \"format\": \"cetta-evprof-v1\",\n \"tsc_hz\": %.0f,\n", hz);
+    fprintf(f, " \"total_ticks\": %llu,\n \"wall_ns\": %llu,\n",
+            (unsigned long long)(t1 - evp_t0), (unsigned long long)(ns1 - evp_ns0));
+    fprintf(f, " \"utime_us\": %lld,\n \"stime_us\": %lld,\n \"maxrss_kb\": %ld,\n",
+            (long long)ru.ru_utime.tv_sec * 1000000 + ru.ru_utime.tv_usec,
+            (long long)ru.ru_stime.tv_sec * 1000000 + ru.ru_stime.tv_usec, ru.ru_maxrss);
+    fprintf(f, " \"top_incl_ticks\": %llu,\n \"top_events\": %llu,\n",
+            (unsigned long long)s->top_incl, (unsigned long long)s->top_events);
+    fprintf(f, " \"overflow\": %llu,\n \"unwound\": %llu,\n \"open_at_exit\": %u,\n",
+            (unsigned long long)s->overflow, (unsigned long long)s->unwound, open_frames);
+    fprintf(f, " \"alloc_bytes_requested\": %llu,\n \"free_null\": %llu,\n",
+            (unsigned long long)evp_alloc_bytes, (unsigned long long)evp_free_null);
+    fprintf(f, " \"calibration\": {\"c_in_min\": %.3f, \"c_out_min\": %.3f, \"c_in_median\": %.3f, \"c_out_median\": %.3f},\n",
+            c_in, c_out, c_in_med, c_out_med);
+    fprintf(f, " \"sites\": [\n");
+    int first = 1;
+    for (int i = 0; i < CETTA_EVP__COUNT; i++) {
+        CettaEvprofSite *st = &cetta_evprof_sites[i];
+        if (i >= CETTA_EVP_CAL_PARENT)
+            continue;
+        fprintf(f, "%s  {\"name\": ", first ? "" : ",\n");
+        evp_json_str(f, evp_names[i]);
+        fprintf(f, ", \"phase\": ");
+        evp_json_str(f, evp_phases[i]);
+        fprintf(f, ", \"calls\": %llu, \"self\": %llu, \"incl\": %llu, \"nchild\": %llu, \"desc\": %llu, \"max_rec\": %llu}",
+                (unsigned long long)st->calls, (unsigned long long)st->self,
+                (unsigned long long)st->incl, (unsigned long long)st->nchild,
+                (unsigned long long)st->desc, (unsigned long long)st->max_depth);
+        first = 0;
+    }
+    fprintf(f, "\n ]\n}\n");
+    fclose(f);
+}
+#endif
diff --git a/src/cetta_evprof.h b/src/cetta_evprof.h
new file mode 100644
index 00000000..e45c4698
--- /dev/null
+++ b/src/cetta_evprof.h
@@ -0,0 +1,134 @@
+#ifndef CETTA_EVPROF_H
+#define CETTA_EVPROF_H
+
+/* cettapack cetta-internals P (0011): opt-in phase timers for the evaluator.
+ * Built only with "make CETTA_EVPROF=1"; with the default CETTA_EVPROF=0
+ * CETTA_EVPROF_SCOPE() expands to nothing and no code or data changes.
+ *
+ * A timed function opens a frame on entry (CETTA_EVPROF_SCOPE as its first
+ * statement) that closes when the function returns (cleanup attribute).
+ * Each frame's time is exclusive: time inside a nested timed function is
+ * charged to that function.  Per site: calls, self ticks, outermost
+ * inclusive ticks, number of direct child frames and of all descendant
+ * frames (for overhead subtraction, see cetta_evprof.c).  Only the main
+ * thread is timed.  The report is written at exit to $CETTA_EVPROF_OUT. */
+#ifndef CETTA_EVPROF
+#define CETTA_EVPROF 0
+#endif
+
+#if CETTA_EVPROF
+#include <stdint.h>
+#include <x86intrin.h>
+
+enum {
+#define EVP(fn, phase) CETTA_EVP_##fn,
+#include "cetta_evprof_sites.def"
+#undef EVP
+    CETTA_EVP_ALLOC_MALLOC,
+    CETTA_EVP_ALLOC_CALLOC,
+    CETTA_EVP_ALLOC_REALLOC,
+    CETTA_EVP_ALLOC_FREE,
+    CETTA_EVP_CAL_PARENT,
+    CETTA_EVP_CAL_CHILD,
+    CETTA_EVP__COUNT
+};
+
+#define CETTA_EVPROF_MAX_DEPTH 4096u
+#define CETTA_EVPROF_NO_FRAME UINT32_MAX
+
+typedef struct {
+    uint64_t start;
+    uint64_t child;  /* ticks inside direct child frames (their inclusive) */
+    uint64_t desc;   /* descendant frames */
+    uint64_t nchild; /* direct child frames */
+    uint32_t site;
+} CettaEvprofFrame;
+
+typedef struct {
+    uint64_t calls, self, incl, nchild, desc;
+    uint64_t active;    /* open frames of this site (recursion) */
+    uint64_t max_depth; /* deepest recursion of this site */
+} CettaEvprofSite;
+
+typedef struct {
+    uint32_t on;    /* 1 on the main thread after start-up */
+    uint32_t depth;
+    uint64_t overflow, unwound;
+    uint64_t top_incl, top_events;
+    CettaEvprofFrame stack[CETTA_EVPROF_MAX_DEPTH];
+} CettaEvprofState;
+
+/* Weak, so every translation unit (also the standalone tool binaries that
+ * compile some instrumented sources without cetta_evprof.c) links. */
+__attribute__((weak)) __thread CettaEvprofState cetta_evprof_tls;
+__attribute__((weak)) CettaEvprofSite cetta_evprof_sites[CETTA_EVP__COUNT];
+
+static inline __attribute__((always_inline)) uint32_t
+cetta_evprof_enter(uint32_t site) {
+    CettaEvprofState *s = &cetta_evprof_tls;
+    if (__builtin_expect(!s->on, 0))
+        return CETTA_EVPROF_NO_FRAME;
+    uint32_t d = s->depth;
+    if (__builtin_expect(d >= CETTA_EVPROF_MAX_DEPTH, 0)) {
+        s->overflow++;
+        return CETTA_EVPROF_NO_FRAME;
+    }
+    CettaEvprofSite *st = &cetta_evprof_sites[site];
+    if (++st->active > st->max_depth)
+        st->max_depth = st->active;
+    CettaEvprofFrame *f = &s->stack[d];
+    f->site = site;
+    f->child = 0;
+    f->desc = 0;
+    f->nchild = 0;
+    s->depth = d + 1u;
+    f->start = __rdtsc();
+    return d;
+}
+
+static inline __attribute__((always_inline)) void
+cetta_evprof_pop(CettaEvprofState *s, uint64_t now) {
+    uint32_t d = --s->depth;
+    CettaEvprofFrame *f = &s->stack[d];
+    uint64_t incl = now - f->start;
+    CettaEvprofSite *st = &cetta_evprof_sites[f->site];
+    st->calls++;
+    st->self += incl - f->child;
+    st->nchild += f->nchild;
+    st->desc += f->desc;
+    if (--st->active == 0)
+        st->incl += incl;
+    if (d) {
+        CettaEvprofFrame *p = &s->stack[d - 1u];
+        p->child += incl;
+        p->nchild++;
+        p->desc += 1u + f->desc;
+    } else {
+        s->top_incl += incl;
+        s->top_events += 1u + f->desc;
+    }
+}
+
+static inline __attribute__((always_inline)) void
+cetta_evprof_leave(uint32_t *tok) {
+    uint64_t now = __rdtsc();
+    uint32_t d = *tok;
+    if (d == CETTA_EVPROF_NO_FRAME)
+        return;
+    CettaEvprofState *s = &cetta_evprof_tls;
+    while (s->depth > d + 1u) { /* frames left open by a non-local exit */
+        s->unwound++;
+        cetta_evprof_pop(s, now);
+    }
+    if (s->depth == d + 1u)
+        cetta_evprof_pop(s, now);
+}
+
+#define CETTA_EVPROF_SCOPE(site)                                              \
+    __attribute__((cleanup(cetta_evprof_leave), unused)) uint32_t             \
+        cetta_evprof_tok_ = cetta_evprof_enter(site)
+#else
+#define CETTA_EVPROF_SCOPE(site) do { } while (0)
+#endif
+
+#endif
