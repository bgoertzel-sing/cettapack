;; S2 bag test t2: proof-output-key-by-id and proof-output-atom-by-id on rows of &proof (the chainer's proof store):
;; one row; a pid with no row; two rows with one output; two rows with different outputs (the compiled code
;; declines: once's choice depends on row order); an output holding a variable (declines: not ground).
!(add-atom &proof (stored-proof-row 101 7 (Inheritance (kb1 ctx ()) (rule p) (STV 1.0 0.7)) k 0.5 () ()))
!(add-atom &proof (stored-proof-row 102 7 plainoutput k 0.5 () ()))
!(add-atom &proof (stored-proof-row 103 7 (Inheritance (kb1 ctx ()) leaf (STV 1.0 0.2)) k 0.5 () ()))
!(add-atom &proof (stored-proof-row 103 8 (Inheritance (kb1 ctx ()) leaf (STV 1.0 0.2)) k 0.6 () ()))
!(add-atom &proof (stored-proof-row 104 7 (Inheritance (kb1 ctx ()) leaf (STV 1.0 0.2)) k 0.5 () ()))
!(add-atom &proof (stored-proof-row 104 8 (Inheritance (kb2 ctx ()) leaf (STV 1.0 0.2)) k 0.6 () ()))
!(add-atom &proof (stored-proof-row 105 7 (Inheritance (kb1 ctx ()) $x (STV 1.0 0.2)) k 0.5 () ()))
!(proof-output-key-by-id 101)
!(proof-output-key-by-id 102)
!(collapse (proof-output-key-by-id 999))
!(proof-output-key-by-id 103)
!(proof-output-key-by-id 104)
!(proof-output-key-by-id 105)
!(proof-output-atom-by-id 101)
!(proof-output-atom-by-id 102)
!(collapse (proof-output-atom-by-id 999))
!(proof-output-atom-by-id 104)
;; an output holding a variable: answered renamed apart, as match answers; two calls' outputs compared
!(proof-output-atom-by-id 105)
!(let* (($a (proof-output-atom-by-id 105)) ($b (proof-output-atom-by-id 105))) (== $a $b))
!(let* (($a (proof-output-atom-by-id 105)) ($b (proof-output-atom-by-id 105))) (=alpha $a $b))
!(let* (($a (proof-output-key-by-id 105)) ($b (proof-output-key-by-id 105))) (== $a $b))
!(let $a (proof-output-atom-by-id 105) (let (Inheritance (kb1 ctx ()) zzz $t) $a $t))
!(proof-output-atom-by-id 105)
(= cpkzero 3)
(= (cpkf $x) (cpkf-called $x))
!(add-atom &proof (stored-proof-row 901 7 (CPU ImplicationCTVFormula ((STV 0.5 0.9)) (CTV (STV 0.99 0.99) (STV 0.1 0.2))) k 0.5 () ()))
!(add-atom &proof (stored-proof-row 902 7 (foo cpkzero) k 0.5 () ()))
!(add-atom &proof (stored-proof-row 903 7 (foo (cpkf 1)) k 0.5 () ()))
!(add-atom &proof (stored-proof-row 904 7 (cpkf 2) k 0.5 () ()))
!(add-atom &proof (stored-proof-row 905 7 cpkzero k 0.5 () ()))
!(add-atom &proof (stored-proof-row 906 7 (foo (+ 1 2)) k 0.5 () ()))
!(add-atom &proof (stored-proof-row 907 7 (tv-confidence (STV 0.5 0.9)) k 0.5 () ()))
;; outputs CeTTa returns as stored: formula leaves, symbols and calls with equations, grounded ops
!(proof-output-atom-by-id 901)
!(proof-output-atom-by-id 902)
!(proof-output-atom-by-id 903)
!(proof-output-atom-by-id 904)
!(proof-output-atom-by-id 905)
!(proof-output-atom-by-id 906)
!(proof-output-atom-by-id 907)
!(proof-output-key-by-id 904)
!(proof-output-key-by-id 905)
